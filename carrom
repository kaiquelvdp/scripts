-- Collect Cash (sempre ativo)
task.spawn(function()
	while true do
		pcall(function()
			game:GetService("ReplicatedStorage").Assets.Remotes.Robbery:FireServer("CollectCash")
		end)
		task.wait(0.1)
	end
end)

task.spawn(function()
	while true do
		for _, prompt in ipairs(workspace:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") and prompt.Enabled then
				prompt.HoldDuration = 0
				local dist = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - prompt.Parent.Position).Magnitude
				if dist < prompt.MaxActivationDistance then
					if tostring(prompt.Parent) == "Handle" and prompt.Parent.Parent.Name == "C4" then
						local heldTool = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Tool")
						if heldTool and (heldTool.Name == "C4" or heldTool.Name == "c4" or heldTool.Name == "Dinamite") then
							pcall(function() fireproximityprompt(prompt) end)
						end
					else
						pcall(function() fireproximityprompt(prompt) end)
					end
				end
			end
		end
		task.wait(0.5)
	end
end)
