-- TP Tween lógica
local tpTweenEnabled = false
local tpTweenSpeed = 0.1 -- Valor inicial do slider

TpTweenToggle.MouseButton1Click:Connect(function()
	tpTweenEnabled = not tpTweenEnabled
	TpTweenToggle.Text = "TP Tween ["..(tpTweenEnabled and "ON" or "OFF").."]"
end)

-- Função para atualizar a velocidade do TP Tween com base na posição do slider
local function updateSlider(t)
	t = math.clamp(t, 0, 1) -- Garante que t está entre 0 e 1
	SliderHandle.Position = UDim2.new(t, 0, -1.5, 0)
	tpTweenSpeed = 0.1 + (2 - 0.1) * t -- Mapeia de 0.1 a 2
	SliderLabel.Text = string.format("%.1f", tpTweenSpeed)
end

-- Lógica do slider para mouse e toque
local dragging = false

SliderHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		local barWidth = SliderBar.AbsoluteSize.X
		local handleWidth = SliderHandle.AbsoluteSize.X
		local minX = SliderBar.AbsolutePosition.X
		local maxX = minX + barWidth - handleWidth
		local t = (input.Position.X - minX) / (maxX - minX)
		updateSlider(t)
	end
end)

SliderHandle.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local barWidth = SliderBar.AbsoluteSize.X
		local handleWidth = SliderHandle.AbsoluteSize.X
		local minX = SliderBar.AbsolutePosition.X
		local maxX = minX + barWidth - handleWidth
		local t = (input.Position.X - minX) / (maxX - minX)
		updateSlider(t)
	end
end)

-- Lógica dos botões de incremento e decremento
local step = 0.1 -- Incremento/decremento de 0.1
DecreaseButton.MouseButton1Click:Connect(function()
	local currentT = (tpTweenSpeed - 0.1) / (2 - 0.1)
	updateSlider(math.max(0, currentT - step / (2 - 0.1)))
end)

IncreaseButton.MouseButton1Click:Connect(function()
	local currentT = (tpTweenSpeed - 0.1) / (2 - 0.1)
	updateSlider(math.min(1, currentT + step / (2 - 0.1)))
end)

RunService.Heartbeat:Connect(function()
	if not tpTweenEnabled then return end
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end

	local humanoid = char.Humanoid
	local hrp = char.HumanoidRootPart

	-- Detectar movimento horizontal e aplicar TP
	if humanoid.MoveDirection.Magnitude > 0.1 and humanoid:GetState() == Enum.HumanoidStateType.Running then
		local moveDir = humanoid.MoveDirection
		local dir = Vector3.new(moveDir.X, 0, moveDir.Z)
		if dir.Magnitude > 0 then
			local newPos = hrp.Position + dir.Unit * tpTweenSpeed
			hrp.CFrame = CFrame.new(newPos, newPos + hrp.CFrame.LookVector)
		end
	end
end)

