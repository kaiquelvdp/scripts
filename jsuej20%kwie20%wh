-- Variável de controle do loop
local rodando = false

-- Função: Comprar C4 (Check + Buy)
local function loopComprarC4()
   local Player = game:GetService("Players").LocalPlayer
   local Event = Player.PlayerGui.ShopSystem.BuyingFunction

   Event:InvokeServer("Check", "C4")
   task.wait(0.1)
   Event:InvokeServer("Buy", "C4")
end

-- Função: Usar automaticamente a C4 ao receber no inventário
local function autoUsarC4()
   local Player = game:GetService("Players").LocalPlayer
   local Backpack = Player:WaitForChild("Backpack")
   local Character = Player.Character or Player.CharacterAdded:Wait()

   local function usar()
      for _, item in pairs(Backpack:GetChildren()) do
         if item.Name == "C4" then
            item.Parent = Character
            task.wait(0.1)
            local tool = Character:FindFirstChild("C4")
            if tool and tool:FindFirstChild("Activate") then
               tool:Activate()
            end
         end
      end
   end

   usar()

   Backpack.ChildAdded:Connect(function(child)
      if rodando and child.Name == "C4" then
         task.wait(0.1)
         usar()
      end
   end)
end

