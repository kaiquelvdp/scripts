-- Keybind Input Handling
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and settingKeybind then
        keybinds[settingKeybind] = input.KeyCode
        if settingKeybind == "ThrowAll" then
            throwAllKeybindButton.Text = input.KeyCode.Name
        elseif settingKeybind == "ThrowTarget" then
            throwTargetKeybindButton.Text = input.KeyCode.Name
        end
        settingKeybind = nil
    elseif input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == keybinds.ThrowAll then
            for _, player in pairs(Players:GetPlayers()) do
                throwPlayer(player)
            end
        elseif input.KeyCode == keybinds.ThrowTarget and currentTarget then
            throwPlayer(currentTarget)
        end
    end
end)
