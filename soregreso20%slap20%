-- Function to Throw Player (Updated to use God's Hand)
local function throwPlayer(player)
    if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local A_1 = "slash"
        local A_2 = player.Character
        local A_3 = Vector3.new(10e10, 10e10, 10e10)
        local Event = LocalPlayer.Backpack:FindFirstChild("God's Hand") and LocalPlayer.Backpack["God's Hand"]:FindFirstChild("Event")
        if Event then
            Event:FireServer(A_1, A_2, A_3)
        end
    end
end

-- Keybind Management
local keybinds = {
    ThrowAll = Enum.KeyCode.F, -- Default keybind for Throw All
    ThrowTarget = Enum.KeyCode.G -- Default keybind for Throw Target
}
local settingKeybind = nil

-- Function to Create Keybind Button
local function createKeybindButton(parent, position, action)
    local keybindButton = Instance.new("TextButton")
    keybindButton.Size = UDim2.new(0, 50, 0, 50)
    keybindButton.Position = position
    keybindButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    keybindButton.Text = keybinds[action].Name
    keybindButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    keybindButton.TextScaled = true
    keybindButton.Font = Enum.Font.Gotham
    keybindButton.Parent = parent
    local keybindCorner = Instance.new("UICorner")
    keybindCorner.CornerRadius = UDim.new(0, 10)
    keybindCorner.Parent = keybindButton
    local keybindStroke = Instance.new("UIStroke")
    keybindStroke.Color = Color3.fromRGB(100, 100, 100)
    keybindStroke.Thickness = 1
    keybindStroke.Parent = keybindButton

    keybindButton.MouseButton1Click:Connect(function()
        keybindButton.Text = "Press a key..."
        settingKeybind = action
    end)

    return keybindButton
end

