local function GetTeamColor(player)
    if player and player.Team then
        return player.Team.TeamColor.Color
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

-- Limpar visuais do ESP
local function ClearESPVisuals(player)
    if ESPVisuals[player] then
        -- Desconectar conexões
        if ESPVisuals[player].Connections then
            for _, connection in pairs(ESPVisuals[player].Connections) do
                pcall(function() connection:Disconnect() end)
            end
        end
        
        -- Destruir objetos
        if ESPVisuals[player].Highlight then
            pcall(function() ESPVisuals[player].Highlight:Destroy() end)
        end
        if ESPVisuals[player].Billboard then
            pcall(function() ESPVisuals[player].Billboard:Destroy() end)
        end
        
        ESPVisuals[player] = nil
    end
end

-- Encontrar a parte principal do personagem (funciona com ragdoll)
local function FindRootPart(character)
    -- Tentar HumanoidRootPart primeiro
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if rootPart then return rootPart end
    
    -- Se não encontrar, tentar Torso ou UpperTorso (R6/R15)
    rootPart = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if rootPart then return rootPart end
    
    -- Último recurso: qualquer BasePart
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            return part
        end
    end
    
    return nil
end

-- Encontrar a cabeça (funciona com ragdoll)
local function FindHead(character)
    local head = character:FindFirstChild("Head")
    if head then return head end
    
    -- Procurar em descendentes
    for _, part in pairs(character:GetDescendants()) do
        if part.Name == "Head" and part:IsA("BasePart") then
            return part
        end
    end
    
    return nil
end

-- Criar ESP para um personagem (SEM verificar vida)
local function SetupCharacterESP(player, character)
    if not ESP_ENABLED then return end
    if not character then return end
    if player == LocalPlayer then return end
    
    -- Limpar ESP antigo
    ClearESPVisuals(player)
    
    -- Encontrar partes (funciona com ragdoll)
    local rootPart = FindRootPart(character)
    local head = FindHead(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Precisa pelo menos de uma parte para o ESP
    if not rootPart and not head then
        warn("[ESP] Nenhuma parte encontrada para: " .. player.Name)
        return
    end
    
    -- Usar head como fallback se não tiver rootPart
    if not rootPart then rootPart = head end
    if not head then head = rootPart end
    
    local teamColor = GetTeamColor(player)
    
    -- ═══════════════════════════════════════
    -- CRIAR HIGHLIGHT (no personagem inteiro)
    -- ═══════════════════════════════════════
    local highlight = Instance.new("Highlight")
    highlight.Name = "PAKAPAKA_Highlight"
    highlight.Adornee = character
    highlight.FillColor = teamColor
    highlight.OutlineColor = teamColor
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    -- ═══════════════════════════════════════
    -- CRIAR NAMETAG (BillboardGui)
    -- ═══════════════════════════════════════
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PAKAPAKA_NameTag"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 80)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = math.huge
    billboard.Parent = head
    
    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.Parent = billboard
    
    -- Nome do jogador
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "PlayerName"
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
    nameLabel.TextColor3 = teamColor
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.Parent = container
    
    -- Status (VIVO/MORTO) + Vida
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(1, 0, 0, 18)
    statusLabel.Position = UDim2.new(0, 0, 0, 22)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "❤ ???"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    statusLabel.TextSize = 13
    statusLabel.Font = Enum.Font.GothamMedium
    statusLabel.TextStrokeTransparency = 0
    statusLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    statusLabel.Parent = container
    
    -- Distância
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Name = "Distance"
    distanceLabel.Size = UDim2.new(1, 0, 0, 16)
    distanceLabel.Position = UDim2.new(0, 0, 0, 42)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = "📏 0m"
    distanceLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    distanceLabel.TextSize = 12
    distanceLabel.Font = Enum.Font.Gotham
    distanceLabel.TextStrokeTransparency = 0
    distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distanceLabel.Parent = container
    
    -- ═══════════════════════════════════════
    -- CONEXÕES E ATUALIZAÇÕES
    -- ═══════════════════════════════════════
    local connections = {}
    
    -- Função para atualizar status e vida
    local function UpdateStatus()
        if humanoid and humanoid.Parent then
            local health = humanoid.Health
            local maxHealth = humanoid.MaxHealth
            local healthPercent = math.clamp(health / maxHealth, 0, 1)
            
            if health <= 0 then
                -- MORTO
                statusLabel.Text = "💀 MORTO"
                statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                highlight.FillColor = Color3.fromRGB(80, 80, 80)
                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                highlight.FillTransparency = 0.8
            else
                -- VIVO
                statusLabel.Text = string.format("❤ %d/%d", math.floor(health), math.floor(maxHealth))
                
                if healthPercent > 0.6 then
                    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                elseif healthPercent > 0.3 then
                    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
                else
                    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
                
                highlight.FillColor = teamColor
                highlight.OutlineColor = teamColor
                highlight.FillTransparency = 0.6
            end
        else
            statusLabel.Text = "❓ DESCONHECIDO"
            statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
    
    -- Conectar mudança de vida (se humanoid existir)
    if humanoid then
        connections.HealthChanged = humanoid.HealthChanged:Connect(UpdateStatus)
        UpdateStatus()
    end
    
    -- Atualizar distância continuamente
    connections.RenderStepped = RunService.RenderStepped:Connect(function()
        -- Verificar se os objetos ainda existem
        if not billboard or not billboard.Parent then return end
        if not rootPart or not rootPart.Parent then
            -- Tentar encontrar nova parte
            local newRoot = FindRootPart(character)
            if newRoot then
                rootPart = newRoot
            else
                return
            end
        end
        
        -- Atualizar Adornee do billboard caso head mude
        local currentHead = FindHead(character)
        if currentHead and billboard.Adornee ~= currentHead then
            billboard.Adornee = currentHead
        end
        
        -- Calcular distância
        if LocalPlayer.Character then
            local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if localRoot and rootPart then
                local distance = (rootPart.Position - localRoot.Position).Magnitude
                distanceLabel.Text = string.format("📏 %dm", math.floor(distance))
            end
        end
    end)
    
    -- Atualizar quando time mudar
    connections.TeamChanged = player:GetPropertyChangedSignal("Team"):Connect(function()
        teamColor = GetTeamColor(player)
        nameLabel.TextColor3 = teamColor
        UpdateStatus()
    end)
    
    -- ═══════════════════════════════════════
    -- MONITORAR SE PERSONAGEM É DESTRUÍDO
    -- ═══════════════════════════════════════
    connections.CharacterDescendantRemoving = character.DescendantRemoving:Connect(function(descendant)
        -- Se a cabeça for removida, tentar encontrar nova
        if descendant == head then
            task.wait(0.1)
            local newHead = FindHead(character)
            if newHead and billboard then
                billboard.Adornee = newHead
                head = newHead
            end
        end
    end)
    
    -- Salvar dados
    ESPVisuals[player] = {
        Highlight = highlight,
        Billboard = billboard,
        Character = character,
        Connections = connections
    }
    
    print("[ESP] ✅ ESP criado para: " .. player.Name)
end

-- Configurar jogador (conexão principal)
local function SetupPlayerESP(player)
    if player == LocalPlayer then return end
    
    if not MainConnections[player] then
        MainConnections[player] = {}
    end
    
    -- Conexão CharacterAdded (permanente)
    local charAddedConn = player.CharacterAdded:Connect(function(character)
        if not ESP_ENABLED then return end
        task.wait(0.3)
        task.spawn(function()
            SetupCharacterESP(player, character)
        end)
    end)
    table.insert(MainConnections[player], charAddedConn)
    
    -- Se já tem personagem, criar ESP agora
    if player.Character then
        task.spawn(function()
            SetupCharacterESP(player, player.Character)
        end)
    end
    
    print("[ESP] 🔗 Monitorando jogador: " .. player.Name)
end

-- Remover jogador completamente
local function RemovePlayerESP(player)
    ClearESPVisuals(player)
    
    if MainConnections[player] then
        for _, conn in pairs(MainConnections[player]) do
            pcall(function() conn:Disconnect() end)
        end
        MainConnections[player] = nil
    end
    
    print("[ESP] 🗑️ Jogador removido: " .. player.Name)
end

-- Inicializar ESP
local function InitializeESP()
    ESP_ENABLED = true
    
    -- Jogadores existentes
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.spawn(function()
                SetupPlayerESP(player)
            end)
        end
    end
    
    -- Novos jogadores
    Players.PlayerAdded:Connect(function(player)
        if ESP_ENABLED and player ~= LocalPlayer then
            task.spawn(function()
                SetupPlayerESP(player)
            end)
        end
    end)
    
    -- Jogador saindo
    Players.PlayerRemoving:Connect(function(player)
        RemovePlayerESP(player)
    end)
    
    -- ═══════════════════════════════════════
    -- LOOP DE VERIFICAÇÃO (backup)
    -- Recria ESP se foi perdido
    -- ═══════════════════════════════════════
    task.spawn(function()
        while ESP_ENABLED do
            task.wait(2)
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    -- Verificar se ESP existe
                    local hasESP = ESPVisuals[player] and ESPVisuals[player].Highlight and ESPVisuals[player].Highlight.Parent
                    
                    if not hasESP then
                        -- Recriar ESP
                        task.spawn(function()
                            SetupCharacterESP(player, player.Character)
                        end)
                    end
                end
            end
        end
    end)
    
    print("[ESP] ✅ Sistema ESP inicializado!")
end

