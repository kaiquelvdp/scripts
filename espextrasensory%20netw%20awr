-- Obter cor do time do jogador
local function GetTeamColor(player)
    if player and player.Team then
        return player.Team.TeamColor.Color
    else
        -- Cor padrão se não tiver time (branco)
        return Color3.fromRGB(255, 255, 255)
    end
end

-- Verificar se o jogador é válido para ESP
local function IsValidTarget(player)
    if not player then return false end
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    return true
end

-- Remover ESP de um jogador
local function RemoveESP(player)
    -- Limpar conexões
    if PlayerESPData[player] then
        for _, connection in pairs(PlayerESPData[player].Connections or {}) do
            if connection then
                pcall(function() connection:Disconnect() end)
            end
        end
        PlayerESPData[player] = nil
    end
    
    -- Remover objetos visuais
    if player.Character then
        local highlight = player.Character:FindFirstChild("PAKAPAKA_Highlight")
        if highlight then highlight:Destroy() end
        
        local head = player.Character:FindFirstChild("Head")
        if head then
            local billboard = head:FindFirstChild("PAKAPAKA_NameTag")
            if billboard then billboard:Destroy() end
        end
    end
end

-- Criar ESP para um jogador
local function CreateESP(player)
    if player == LocalPlayer then return end
    
    -- Função interna para setup do ESP
    local function SetupCharacterESP(character)
        if not ESP_ENABLED then return end
        if not character then return end
        
        -- Esperar componentes carregarem
        local humanoid = character:WaitForChild("Humanoid", 5)
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        local head = character:WaitForChild("Head", 5)
        
        if not humanoid or not rootPart or not head then return end
        if humanoid.Health <= 0 then return end
        
        -- Remover ESP existente primeiro
        RemoveESP(player)
        
        -- Obter cor do time
        local teamColor = GetTeamColor(player)
        
        -- ═══════════════════════════════════════
        -- CRIAR HIGHLIGHT
        -- ═══════════════════════════════════════
        local highlight = Instance.new("Highlight")
        highlight.Name = "PAKAPAKA_Highlight"
        highlight.Adornee = character
        highlight.FillColor = teamColor
        highlight.OutlineColor = teamColor
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = character
        
        -- ═══════════════════════════════════════
        -- CRIAR NAMETAG (SEM BARRA DE VIDA)
        -- ═══════════════════════════════════════
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "PAKAPAKA_NameTag"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 200, 0, 70)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.MaxDistance = math.huge
        billboard.Parent = head
        
        -- Frame container
        local container = Instance.new("Frame")
        container.Name = "Container"
        container.Size = UDim2.new(1, 0, 1, 0)
        container.BackgroundTransparency = 1
        container.Parent = billboard
        
        -- Nome do jogador
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name = "PlayerName"
        nameLabel.Size = UDim2.new(1, 0, 0, 20)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        nameLabel.TextColor3 = teamColor
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = container
        
        -- Texto de vida (SEM BARRA)
        local healthText = Instance.new("TextLabel")
        healthText.Name = "HealthText"
        healthText.Size = UDim2.new(1, 0, 0, 18)
        healthText.Position = UDim2.new(0, 0, 0, 22)
        healthText.BackgroundTransparency = 1
        healthText.Text = string.format("%d/%d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
        healthText.TextColor3 = Color3.fromRGB(255, 100, 100)
        healthText.TextSize = 13
        healthText.Font = Enum.Font.GothamMedium
        healthText.TextStrokeTransparency = 0
        healthText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        healthText.Parent = container
        
        -- Distância em metros
        local distanceLabel = Instance.new("TextLabel")
        distanceLabel.Name = "Distance"
        distanceLabel.Size = UDim2.new(1, 0, 0, 16)
        distanceLabel.Position = UDim2.new(0, 0, 0, 42)
        distanceLabel.BackgroundTransparency = 1
        distanceLabel.Text = "0m"
        distanceLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        distanceLabel.TextSize = 12
        distanceLabel.Font = Enum.Font.Gotham
        distanceLabel.TextStrokeTransparency = 0
        distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distanceLabel.Parent = container
        
        -- ═══════════════════════════════════════
        -- CONEXÕES E ATUALIZAÇÕES
        -- ═══════════════════════════════════════
        
        local connections = {}
        
        -- Atualizar vida
        local function UpdateHealth()
            if not humanoid or not humanoid.Parent then return end
            
            local health = humanoid.Health
            local maxHealth = humanoid.MaxHealth
            local healthPercent = math.clamp(health / maxHealth, 0, 1)
            
            -- Cor do texto baseada na vida
            if healthPercent > 0.6 then
                healthText.TextColor3 = Color3.fromRGB(100, 255, 100)
            elseif healthPercent > 0.3 then
                healthText.TextColor3 = Color3.fromRGB(255, 255, 100)
            else
                healthText.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            
            -- Atualizar texto
            healthText.Text = string.format("%d/%d", math.floor(health), math.floor(maxHealth))
        end
        
        connections.HealthChanged = humanoid.HealthChanged:Connect(UpdateHealth)
        UpdateHealth() -- Atualizar inicialmente
        
        -- Atualizar distância
        connections.RenderStepped = RunService.RenderStepped:Connect(function()
            if not rootPart or not rootPart.Parent then return end
            if not LocalPlayer.Character then return end
            
            local localRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not localRoot then return end
            
            local distance = (rootPart.Position - localRoot.Position).Magnitude
            distanceLabel.Text = string.format("%dm", math.floor(distance))
        end)
        
        -- Quando morrer
        connections.Died = humanoid.Died:Connect(function()
            RemoveESP(player)
        end)
        
        -- Quando o time mudar, atualizar cor
        connections.TeamChanged = player:GetPropertyChangedSignal("Team"):Connect(function()
            local newColor = GetTeamColor(player)
            
            -- Atualizar cores
            highlight.FillColor = newColor
            highlight.OutlineColor = newColor
            nameLabel.TextColor3 = newColor
        end)
        
        -- Salvar dados do ESP
        PlayerESPData[player] = {
            Highlight = highlight,
            Billboard = billboard,
            Connections = connections
        }
    end
    
    -- Setup se já tem personagem
    if player.Character then
        task.spawn(function()
            SetupCharacterESP(player.Character)
        end)
    end
    
    -- Quando personagem spawnar
    local characterAddedConnection = player.CharacterAdded:Connect(function(character)
        task.wait(0.5) -- Esperar um pouco para garantir que tudo carregou
        SetupCharacterESP(character)
    end)
    
    -- Salvar conexão
    if not ESPConnections[player] then
        ESPConnections[player] = {}
    end
    table.insert(ESPConnections[player], characterAddedConnection)
end

-- Inicializar ESP para todos os jogadores
local function InitializeESP()
    ESP_ENABLED = true
    
    -- Criar ESP para jogadores existentes
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.spawn(function()
                CreateESP(player)
            end)
        end
    end
    
    -- Detectar novos jogadores entrando
    Players.PlayerAdded:Connect(function(player)
        if ESP_ENABLED then
            CreateESP(player)
        end
    end)
    
    -- Limpar quando jogador sair
    Players.PlayerRemoving:Connect(function(player)
        RemoveESP(player)
        
        -- Limpar conexões principais
        if ESPConnections[player] then
            for _, connection in pairs(ESPConnections[player]) do
                pcall(function() connection:Disconnect() end)
            end
            ESPConnections[player] = nil
        end
    end)
end

-- Função para desativar ESP (caso necessário)
local function DisableESP()
    ESP_ENABLED = false
    
    for _, player in ipairs(Players:GetPlayers()) do
        RemoveESP(player)
    end
end

