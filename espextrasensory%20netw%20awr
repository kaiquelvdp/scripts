local function CreateLoadingScreen()
    -- Criar ScreenGui
    local LoadingGui = Instance.new("ScreenGui")
    LoadingGui.Name = "PakapakaLoading"
    LoadingGui.ResetOnSpawn = false
    LoadingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    LoadingGui.IgnoreGuiInset = true
    LoadingGui.Parent = PlayerGui
    
    -- Frame de fundo principal
    local Background = Instance.new("Frame")
    Background.Name = "Background"
    Background.Size = UDim2.new(1, 0, 1, 0)
    Background.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    Background.BorderSizePixel = 0
    Background.Parent = LoadingGui
    
    -- Gradiente de fundo
    local BGGradient = Instance.new("UIGradient")
    BGGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 10, 30)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(10, 5, 20)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 0, 15))
    })
    BGGradient.Rotation = 45
    BGGradient.Parent = Background
    
    -- Container central
    local CenterContainer = Instance.new("Frame")
    CenterContainer.Name = "CenterContainer"
    CenterContainer.Size = UDim2.new(0, 400, 0, 250)
    CenterContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
    CenterContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    CenterContainer.BackgroundTransparency = 1
    CenterContainer.Parent = Background
    
    -- Imagem/Decal do loading
    local LoadingImage = Instance.new("ImageLabel")
    LoadingImage.Name = "LoadingImage"
    LoadingImage.Size = UDim2.new(0, 120, 0, 120)
    LoadingImage.Position = UDim2.new(0.5, 0, 0.3, 0)
    LoadingImage.AnchorPoint = Vector2.new(0.5, 0.5)
    LoadingImage.BackgroundTransparency = 1
    LoadingImage.Image = "rbxassetid://558104238"
    LoadingImage.ImageTransparency = 0
    LoadingImage.Parent = CenterContainer
    
    -- Efeito de brilho na imagem
    local ImageCorner = Instance.new("UICorner")
    ImageCorner.CornerRadius = UDim.new(0.1, 0)
    ImageCorner.Parent = LoadingImage
    
    -- Texto "Carregando..."
    local LoadingText = Instance.new("TextLabel")
    LoadingText.Name = "LoadingText"
    LoadingText.Size = UDim2.new(1, 0, 0, 40)
    LoadingText.Position = UDim2.new(0.5, 0, 0.65, 0)
    LoadingText.AnchorPoint = Vector2.new(0.5, 0)
    LoadingText.BackgroundTransparency = 1
    LoadingText.Text = "Carregando"
    LoadingText.TextSize = 28
    LoadingText.Font = Enum.Font.GothamBold
    LoadingText.TextColor3 = Color3.fromRGB(200, 150, 255)
    LoadingText.Parent = CenterContainer
    
    -- UIStroke no texto
    local TextStroke = Instance.new("UIStroke")
    TextStroke.Color = Color3.fromRGB(80, 40, 120)
    TextStroke.Thickness = 2
    TextStroke.Parent = LoadingText
    
    -- Barra de progresso (background)
    local ProgressBarBG = Instance.new("Frame")
    ProgressBarBG.Name = "ProgressBarBG"
    ProgressBarBG.Size = UDim2.new(0.8, 0, 0, 8)
    ProgressBarBG.Position = UDim2.new(0.5, 0, 0.85, 0)
    ProgressBarBG.AnchorPoint = Vector2.new(0.5, 0.5)
    ProgressBarBG.BackgroundColor3 = Color3.fromRGB(40, 30, 50)
    ProgressBarBG.BorderSizePixel = 0
    ProgressBarBG.Parent = CenterContainer
    
    local ProgressBGCorner = Instance.new("UICorner")
    ProgressBGCorner.CornerRadius = UDim.new(1, 0)
    ProgressBGCorner.Parent = ProgressBarBG
    
    -- Barra de progresso (preenchimento)
    local ProgressBarFill = Instance.new("Frame")
    ProgressBarFill.Name = "ProgressBarFill"
    ProgressBarFill.Size = UDim2.new(0, 0, 1, 0)
    ProgressBarFill.BackgroundColor3 = Color3.fromRGB(180, 100, 255)
    ProgressBarFill.BorderSizePixel = 0
    ProgressBarFill.Parent = ProgressBarBG
    
    local ProgressFillCorner = Instance.new("UICorner")
    ProgressFillCorner.CornerRadius = UDim.new(1, 0)
    ProgressFillCorner.Parent = ProgressBarFill
    
    -- Gradiente na barra de progresso
    local ProgressGradient = Instance.new("UIGradient")
    ProgressGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 80, 220)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 130, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 100, 240))
    })
    ProgressGradient.Parent = ProgressBarFill
    
    -- Texto de porcentagem
    local PercentText = Instance.new("TextLabel")
    PercentText.Name = "PercentText"
    PercentText.Size = UDim2.new(1, 0, 0, 25)
    PercentText.Position = UDim2.new(0.5, 0, 0.92, 0)
    PercentText.AnchorPoint = Vector2.new(0.5, 0)
    PercentText.BackgroundTransparency = 1
    PercentText.Text = "0%"
    PercentText.TextSize = 16
    PercentText.Font = Enum.Font.GothamMedium
    PercentText.TextColor3 = Color3.fromRGB(150, 130, 180)
    PercentText.Parent = CenterContainer
    
    -- Partículas decorativas (pontos flutuantes)
    local function CreateParticle()
        local particle = Instance.new("Frame")
        particle.Size = UDim2.new(0, math.random(2, 6), 0, math.random(2, 6))
        particle.Position = UDim2.new(math.random() * 0.9 + 0.05, 0, 1.1, 0)
        particle.BackgroundColor3 = Color3.fromRGB(
            math.random(150, 220),
            math.random(80, 150),
            math.random(200, 255)
        )
        particle.BackgroundTransparency = math.random() * 0.5
        particle.BorderSizePixel = 0
        particle.Parent = Background
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = particle
        
        -- Animação subindo
        local tween = TweenService:Create(particle, TweenInfo.new(
            math.random(3, 6),
            Enum.EasingStyle.Linear
        ), {
            Position = UDim2.new(particle.Position.X.Scale, 0, -0.1, 0),
            BackgroundTransparency = 1
        })
        tween:Play()
        tween.Completed:Connect(function()
            particle:Destroy()
        end)
    end
    
    -- Spawn de partículas
    local particleConnection
    particleConnection = RunService.RenderStepped:Connect(function()
        if math.random() < 0.05 then
            CreateParticle()
        end
    end)
    
    -- ═══════════════════════════════════════
    -- ANIMAÇÕES
    -- ═══════════════════════════════════════
    
    -- Animação de rotação na imagem
    local imageRotation = 0
    local pulseDirection = 1
    local pulseValue = 0
    
    local imageAnimConnection = RunService.RenderStepped:Connect(function(dt)
        -- Efeito de pulse suave
        pulseValue = pulseValue + (dt * pulseDirection * 0.8)
        if pulseValue >= 1 then
            pulseDirection = -1
        elseif pulseValue <= 0 then
            pulseDirection = 1
        end
        
        local scale = 1 + (pulseValue * 0.08)
        LoadingImage.Size = UDim2.new(0, 120 * scale, 0, 120 * scale)
    end)
    
    -- Animação dos pontos "Carregando..."
    local dots = 0
    local dotsTexts = {"Carregando", "Carregando.", "Carregando..", "Carregando..."}
    
    task.spawn(function()
        while LoadingGui.Parent do
            dots = (dots % 4) + 1
            LoadingText.Text = dotsTexts[dots]
            task.wait(0.4)
        end
    end)
    
    -- Animação da barra de progresso (10 segundos)
    local loadingDuration = 10
    local startTime = tick()
    
    local progressConnection
    progressConnection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed / loadingDuration, 0, 1)
        
        -- Adicionar pequena variação para parecer mais realista
        local displayProgress = progress
        if progress < 0.95 then
            displayProgress = progress + (math.sin(elapsed * 2) * 0.02)
            displayProgress = math.clamp(displayProgress, 0, progress + 0.05)
        end
        
        ProgressBarFill.Size = UDim2.new(displayProgress, 0, 1, 0)
        PercentText.Text = string.format("%d%%", math.floor(displayProgress * 100))
        
        -- Animação do gradiente
        ProgressGradient.Offset = Vector2.new(math.sin(elapsed * 3) * 0.3, 0)
    end)
    
    -- Aguardar 10 segundos
    task.wait(loadingDuration)
    
    -- Garantir 100%
    ProgressBarFill.Size = UDim2.new(1, 0, 1, 0)
    PercentText.Text = "100%"
    LoadingText.Text = "Concluído!"
    LoadingText.TextColor3 = Color3.fromRGB(100, 255, 150)
    
    task.wait(0.5)
    
    -- Parar animações
    particleConnection:Disconnect()
    imageAnimConnection:Disconnect()
    progressConnection:Disconnect()
    
    -- ═══════════════════════════════════════
    -- FADEOUT
    -- ═══════════════════════════════════════
    
    local fadeInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    TweenService:Create(Background, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(LoadingImage, fadeInfo, {ImageTransparency = 1}):Play()
    TweenService:Create(LoadingText, fadeInfo, {TextTransparency = 1}):Play()
    TweenService:Create(TextStroke, fadeInfo, {Transparency = 1}):Play()
    TweenService:Create(ProgressBarBG, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(ProgressBarFill, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(PercentText, fadeInfo, {TextTransparency = 1}):Play()
    
    task.wait(1.1)
    
    -- Destruir GUI
    LoadingGui:Destroy()
    
    return true
end

