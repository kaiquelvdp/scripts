-- InstaProximityPrompt Toggle (Sets HoldDuration to 0 and MaxActivationDistance to 10 for all Item Chests)
local proximityConnection
MainTab:CreateToggle({
    Name = "InstaProximityPrompt",
    Info = "Sets HoldDuration to 0 and range to 10 for all ProximityPrompts in Items folder.",
    CurrentValue = false,
    Callback = function(Value)
        local function updateProximityPrompts()
            for _, item in pairs(Workspace.Items:GetChildren()) do
                if item.Name:match("Item Chest") and item:FindFirstChild("Main") and item.Main:FindFirstChild("ProximityAttachment") and item.Main.ProximityAttachment:FindFirstChild("ProximityInteraction") then
                    item.Main.ProximityAttachment.ProximityInteraction.HoldDuration = Value and 0 or 1
                    item.Main.ProximityAttachment.ProximityInteraction.MaxActivationDistance = Value and 10 or 6
                end
            end
        end
        if Value then
            updateProximityPrompts()
            proximityConnection = RunService.Heartbeat:Connect(updateProximityPrompts)
        else
            if proximityConnection then
                proximityConnection:Disconnect()
            end
            updateProximityPrompts() -- Reset to default
        end
        Rayfield:Notify({
            Title = Value and "InstaProximity Enabled" or "InstaProximity Disabled",
            Content = Value and "Proximity prompts set to instant with range 10." or "Proximity prompts reset.",
            Duration = 3
        })
    end
})

-- WalkSpeed Toggle and Slider
local walkSpeedConnection
local CurrentWalkSpeed = 16
MainTab:CreateToggle({
    Name = "WalkSpeed Boost",
    Info = "Enables custom WalkSpeed for the player.",
    CurrentValue = false,
    Callback = function(Value)
        local defaultSpeed = 16
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if not humanoid then
            Rayfield:Notify({
                Title = "Error",
                Text = "Humanoid not found. Please ensure your character is loaded.",
                Duration = 3
            })
            return
        end
        if not Value then
            humanoid.WalkSpeed = defaultSpeed
            if walkSpeedConnection then
                walkSpeedConnection:Disconnect()
            end
        else
            walkSpeedConnection = RunService.Heartbeat:Connect(function()
                if humanoid.WalkSpeed ~= CurrentWalkSpeed then
                    humanoid.WalkSpeed = CurrentWalkSpeed
                end
            end)
        end
        Rayfield:Notify({
            Title = Value and "WalkSpeed Boost Enabled" or "WalkSpeed Boost Disabled",
            Content = Value and "WalkSpeed set to custom value." or "WalkSpeed reset to default.",
            Duration = 3
        })
    end
})

