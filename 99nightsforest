-- Chests Section
TpResourcesTab:CreateLabel("Chests")

TpResourcesTab:CreateButton({
    Name = "Teleport to Active Chest",
    Info = "Teleports to the nearest Item Chest with an active ProximityPrompt.",
    Callback = function()
        local character = LocalPlayer.Character
        if not character then
            Rayfield:Notify({
                Title = "Error",
                Text = "Character not found. Please ensure your character is loaded.",
                Duration = 3
            })
            return
        end
        for i = 1, 20 do
            local chestName = i == 1 and "Item Chest" or "Item Chest" .. i
            local chest = Workspace.Items:FindFirstChild(chestName)
            if chest and chest:FindFirstChild("Main") and chest.Main:FindFirstChild("ProximityAttachment") and chest.Main.ProximityAttachment:FindFirstChild("ProximityInteraction") then
                if chest.Main.ProximityAttachment.ProximityInteraction.Enabled then
                    character:PivotTo(chest:GetPivot())
                    Rayfield:Notify({
                        Title = "Teleported",
                        Content = "Teleported to " .. chestName .. ".",
                        Duration = 3
                    })
                    return
                end
            end
        end
        Rayfield:Notify({
            Title = "No Active Chest Found",
            Text = "No Item Chest with an active ProximityPrompt was found.",
            Duration = 3
        })
    end
})

