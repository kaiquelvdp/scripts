-- Kill Aura Toggle
local killAuraConnection
MainTab:CreateToggle({
    Name = "Kill Aura",
    Info = "Attacks all NPCs in workspace.Characters using the equipped tool.",
    CurrentValue = false,
    Callback = function(Value)
        if Value then
            killAuraConnection = RunService.Heartbeat:Connect(function()
                local character = LocalPlayer.Character
                if not character then return end

                -- Find the currently equipped tool (check Character and Inventory)
                local tool = character:FindFirstChildWhichIsA("Tool") or (LocalPlayer:FindFirstChild("Inventory") and LocalPlayer.Inventory:FindFirstChildWhichIsA("Tool"))
                if not tool then return end

                -- Get the ToolDamageObject remote event
                local toolDamageEvent = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("ToolDamageObject")
                if not toolDamageEvent then return end

                -- Get the player's CFrame for the attack position
                local playerCFrame = character:GetPivot()

                -- Iterate through all NPCs in workspace.Characters
                for _, npc in pairs(Workspace.Characters:GetChildren()) do
                    if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid") and npc:FindFirstChildOfClass("Humanoid").Health > 0 then
                        -- Invoke the ToolDamageObject event with all parameters
                        pcall(function()
                            toolDamageEvent:InvokeServer(npc, tool, "5_8680620284", playerCFrame)
                        end)
                    end
                end
                wait(0.1) -- Slight delay to prevent performance issues
            end)
        else
            if killAuraConnection then
                killAuraConnection:Disconnect()
                killAuraConnection = nil
            end
        end
    end
})

