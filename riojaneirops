local autoFarmFazendeiroAtivo = false
local floatPart = nil

local fazendeiroBtn = newBtn("Auto Farm Fazendeiro (OFF)")
fazendeiroBtn.Parent = mainFrame

fazendeiroBtn.MouseButton1Click:Connect(function()
    autoFarmFazendeiroAtivo = not autoFarmFazendeiroAtivo
    fazendeiroBtn.Text = autoFarmFazendeiroAtivo and "Auto Farm Fazendeiro (ON)" or "Auto Farm Fazendeiro (OFF)"

    -- Criar ou destruir float
    if autoFarmFazendeiroAtivo then
        if not floatPart then
            floatPart = Instance.new("Part")
            floatPart.Anchored = true
            floatPart.CanCollide = true
            floatPart.Size = Vector3.new(6,1,6)
            floatPart.Transparency = 1
            floatPart.Parent = workspace
        end
        -- Atualizar float
        RunService.Heartbeat:Connect(function()
            if autoFarmFazendeiroAtivo and floatPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                floatPart.Position = LocalPlayer.Character.HumanoidRootPart.Position - Vector3.new(0,3,0)
            end
        end)
    else
        if floatPart then
            floatPart:Destroy()
            floatPart = nil
        end
    end
end)

