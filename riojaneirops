local Players = game:GetService("Players") local RunService = game:GetService("RunService") local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer local mouse = player:GetMouse() local character = player.Character or player.CharacterAdded:Wait() local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Variáveis globais local autoFarmLixeiro = false local autoFarmFazendeiro = false local floatPart = nil

-- Função para criar Float local function createFloat() if floatPart then floatPart:Destroy() end floatPart = Instance.new("Part") floatPart.Size = Vector3.new(6, 1, 6) floatPart.Anchored = true floatPart.Transparency = 1 floatPart.CanCollide = true floatPart.Parent = workspace

RunService.Heartbeat:Connect(function()
    if autoFarmFazendeiro and character and humanoidRootPart then
        floatPart.Position = humanoidRootPart.Position - Vector3.new(0, 6, 0)
    end
end)

end

-- Função Delete Part local function deletePart() local target = workspace:GetChildren()[3269]:GetChildren()[2] if target then target:Destroy() end end

-- Função Teleport Point local function teleportPoint() humanoidRootPart.CFrame = CFrame.new(-1560, 4, -395) end

-- Função AntiLag local function antiLag() for _, obj in ipairs(workspace:GetDescendants()) do if obj:IsA("Texture") or obj:IsA("Decal") then obj:Destroy() elseif obj:IsA("BasePart") then obj.Material = Enum.Material.SmoothPlastic obj.Reflectance = 0 elseif obj:IsA("MeshPart") then obj.Material = Enum.Material.SmoothPlastic end end if game.Lighting:FindFirstChildOfClass("BlurEffect") then game.Lighting:FindFirstChildOfClass("BlurEffect"):Destroy() end end

-- Função Auto Farm Lixeiro local function startAutoFarmLixeiro() spawn(function() while autoFarmLixeiro do local coleta = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Lixeiro.Coleta:GetChildren()[3] local entrega = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Lixeiro.Entrega.Part

for i = 1, 10 do
            if coleta:FindFirstChildOfClass("ProximityPrompt") then
                fireproximityprompt(coleta:FindFirstChildOfClass("ProximityPrompt"))
            end
            if entrega:FindFirstChildOfClass("ProximityPrompt") then
                fireproximityprompt(entrega:FindFirstChildOfClass("ProximityPrompt"))
            end
        end
        task.wait(2)
    end
end)

end

-- Função Auto Farm Fazendeiro local function startAutoFarmFazendeiro() createFloat() spawn(function() while autoFarmFazendeiro do local coleta = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Fazendeiro.Coleta.Part local entrega = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Fazendeiro.Entrega:GetChildren()[3]

humanoidRootPart.CFrame = coleta.CFrame - Vector3.new(0, 6, 0)
        for i = 1, 10 do
            if coleta:FindFirstChildOfClass("ProximityPrompt") then
                fireproximityprompt(coleta:FindFirstChildOfClass("ProximityPrompt"))
            end
        end
        task.wait(2.5)

        humanoidRootPart.CFrame = entrega.CFrame - Vector3.new(0, 6, 0)
        for i = 1, 10 do
            if entrega:FindFirstChildOfClass("ProximityPrompt") then
                fireproximityprompt(entrega:FindFirstChildOfClass("ProximityPrompt"))
            end
        end
        task.wait(2.5)
    end
end)

end

