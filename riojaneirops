-- Auto Farm Logic
autoFarmButton.MouseButton1Click:Connect(function()
    autoFarmToggle = not autoFarmToggle
    autoFarmButton.Text = "Auto Farm: " .. (autoFarmToggle and "ON" or "OFF")
    
    if autoFarmToggle then
        spawn(function()
            local currentWaypoint = waypoint1
            while autoFarmToggle do
                if npcMoveToggle then
                    -- NPC-like movement using PathfindingService
                    local path = PathfindingService:CreatePath()
                    path:ComputeAsync(character.HumanoidRootPart.Position, currentWaypoint)
                    if path.Status == Enum.PathStatus.Success then
                        local waypoints = path:GetWaypoints()
                        for _, wp in ipairs(waypoints) do
                            humanoid:MoveTo(wp.Position)
                            humanoid.MoveToFinished:Wait()
                        end
                    end
                elseif moveTeleportToggle then
                    -- Teleport movement
                    character.HumanoidRootPart.CFrame = CFrame.new(currentWaypoint)
                end
                
                -- Simulate key E press (requires VirtualInputManager, may need exploit)
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                wait(0.1)  -- Short hold
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                
                wait(3)  -- Wait 10 seconds
                
                -- Switch waypoint
                currentWaypoint = (currentWaypoint == waypoint1) and waypoint2 or waypoint1
            end
        end)
    end
end)

