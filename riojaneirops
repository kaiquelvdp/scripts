-- Função auxiliar: ativar ProximityPrompt várias vezes
local function ativarProximityPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        for i = 1, 10 do
            fireproximityprompt(prompt)
            task.wait(0.05)
        end
    end
end

-- AUTO FARM LIXEIRO
local AutoFarmBtn = criarBotao("Auto Farm Lixeiro (Toggle)", 3)
AutoFarmBtn.MouseButton1Click:Connect(function()
    autoFarmLixeiroAtivo = not autoFarmLixeiroAtivo
    warn("Auto Farm Lixeiro:", autoFarmLixeiroAtivo)

    task.spawn(function()
        while autoFarmLixeiroAtivo do
            local coleta = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Lixeiro.Coleta:GetChildren()[3]
            local entrega = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Lixeiro.Entrega.Part

            if coleta then
                local prompt = coleta:FindFirstChildOfClass("ProximityPrompt")
                ativarProximityPrompt(prompt)
            end

            if entrega then
                local prompt = entrega:FindFirstChildOfClass("ProximityPrompt")
                ativarProximityPrompt(prompt)
            end

            task.wait(2)
        end
    end)
end)

-- Funções FLOAT para Fazendeiro
local function criarFloat()
    if not floatPart then
        floatPart = Instance.new("Part")
        floatPart.Size = Vector3.new(6,1,6)
        floatPart.Anchored = true
        floatPart.CanCollide = true
        floatPart.Transparency = 0.5
        floatPart.Color = Color3.fromRGB(0,255,0)
        floatPart.Material = Enum.Material.ForceField
        floatPart.Parent = workspace
    end
end
local function destruirFloat()
    if floatPart then floatPart:Destroy() floatPart=nil end
end
RunService.Heartbeat:Connect(function()
    if autoFarmFazendeiroAtivo and floatPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        floatPart.Position = LocalPlayer.Character.HumanoidRootPart.Position - Vector3.new(0,5,0)
    end
end)

-- AUTO FARM FAZENDEIRO
local FazendeiroBtn = criarBotao("Auto Farm Fazendeiro (Toggle)", 4)
FazendeiroBtn.MouseButton1Click:Connect(function()
    autoFarmFazendeiroAtivo = not autoFarmFazendeiroAtivo
    warn("Auto Farm Fazendeiro:", autoFarmFazendeiroAtivo)

    if autoFarmFazendeiroAtivo then
        criarFloat()
        task.spawn(function()
            while autoFarmFazendeiroAtivo do
                local coleta = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Fazendeiro.Coleta.Part
                local entrega = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Fazendeiro.Entrega:GetChildren()[3]

                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart

                    if coleta then
                        hrp.CFrame = coleta.CFrame - Vector3.new(0,12,0)
                        task.wait(0.2)
                        ativarProximityPrompt(coleta:FindFirstChildOfClass("ProximityPrompt"))
                    end

                    task.wait(2.5)

                    if entrega then
                        hrp.CFrame = entrega.CFrame - Vector3.new(0,12,0)
                        task.wait(0.2)
                        ativarProximityPrompt(entrega:FindFirstChildOfClass("ProximityPrompt"))
                    end
                end
                task.wait(2.5)
            end
        end)
    else
        destruirFloat()
    end
end)

-- ANTILAG
local AntiLagBtn = criarBotao("Antilag", 5)
AntiLagBtn.MouseButton1Click:Connect(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.Plastic
            obj.Color = Color3.fromRGB(163,162,165)
            if obj:FindFirstChild("Texture") then obj.Texture:Destroy() end
            if obj:FindFirstChild("Decal") then obj.Decal:Destroy() end
        elseif obj:IsA("MeshPart") then
            obj.Material = Enum.Material.Plastic
            obj.Color = Color3.fromRGB(163,162,165)
            obj.TextureID = ""
        end
    end

    for _, e in ipairs(Lighting:GetChildren()) do
        if e:IsA("BlurEffect") or e:IsA("ColorCorrectionEffect") or e:IsA("SunRaysEffect") then
            e:Destroy()
        end
    end
    warn("Antilag ativado.")
end)
