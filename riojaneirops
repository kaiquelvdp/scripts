end)

task.spawn(function()
    while task.wait(0.5) do
        if lixeiroToggle then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local coleta = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Lixeiro.Coleta:GetChildren()[3]
                local entrega = workspace.xWorkspace.Sistemas.Empregos.Opcoes.Lixeiro.Entrega:FindFirstChild("Part")

                if coleta and entrega then
                    hrp.CFrame = CFrame.new(coleta.Position - Vector3.new(0,6,0))
