                if coleta and entrega then
                    hrp.CFrame = CFrame.new(coleta.Position - Vector3.new(0,6,0))
                    task.wait(0.3)
                    firePrompt(coleta:FindFirstChildOfClass("ProximityPrompt"))

                    task.wait(2.5)

                    hrp.CFrame = CFrame.new(entrega.Position - Vector3.new(0,6,0))
                    task.wait(0.3)
                    firePrompt(entrega:FindFirstChildOfClass("ProximityPrompt"))
                end
            end
        end
    end
end)
