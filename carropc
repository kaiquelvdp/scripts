-- GUI de keybinds
local keyFrame = Instance.new("Frame", gui)
keyFrame.Position = UDim2.new(0.3, 0, 0.3, 0)
keyFrame.Size = UDim2.new(0, 280, 0, 180)
keyFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
keyFrame.BorderColor3 = Color3.fromRGB(212, 175, 55)
keyFrame.BorderSizePixel = 2
keyFrame.Active = true
keyFrame.Draggable = true

local function makeBindButton(name, posY)
	local label = Instance.new("TextLabel", keyFrame)
	label.Position = UDim2.new(0.05, 0, posY, 0)
	label.Size = UDim2.new(0, 100, 0, 25)
	label.Text = name
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.Gotham
	label.TextSize = 14

	local button = Instance.new("TextButton", keyFrame)
	button.Position = UDim2.new(0.45, 0, posY, 0)
	button.Size = UDim2.new(0, 120, 0, 25)
	button.Text = "Clique para definir"
	button.Font = Enum.Font.Gotham
	button.TextSize = 14
	button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	button.TextColor3 = Color3.new(1, 1, 1)

	button.MouseButton1Click:Connect(function()
		button.Text = "Aguardando tecla..."
		local inputConn
		inputConn = UIS.InputBegan:Connect(function(input, gameProcessed)
			if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
				keybinds[name] = input.KeyCode
				button.Text = input.KeyCode.Name
				inputConn:Disconnect()
			end
		end)
	end)
end

makeBindButton("AutoFarm", 0.1)
makeBindButton("AutoBank", 0.4)
makeBindButton("TpNPC", 0.7)

local confirm = Instance.new("TextButton", keyFrame)
confirm.Size = UDim2.new(0.9, 0, 0, 30)
confirm.Position = UDim2.new(0.05, 0, 0.88, 0)
confirm.Text = "Confirmar"
confirm.Font = Enum.Font.GothamBold
confirm.TextSize = 14
confirm.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
confirm.TextColor3 = Color3.new(1, 1, 1)

confirm.MouseButton1Click:Connect(function()
	keyFrame.Visible = false
	settingKeys = false
	showNotification("Keybinds definidas!")
end)

-- Monitorar tecla pressionada
UIS.InputBegan:Connect(function(input, gp)
	if gp or settingKeys then return end
	if input.KeyCode == keybinds.AutoFarm then
		autoFarmEnabled = not autoFarmEnabled
		showNotification("Auto Farm " .. (autoFarmEnabled and "ON" or "OFF"))
	elseif input.KeyCode == keybinds.AutoBank then
		autoBankEnabled = not autoBankEnabled
		showNotification("Auto BANK " .. (autoBankEnabled and "ON" or "OFF"))
	elseif input.KeyCode == keybinds.TpNPC then
		LocalPlayer.Character:MoveTo(Vector3.new(-584, 31, 347))
		showNotification("Teleportado com sucesso")
	end
end)

