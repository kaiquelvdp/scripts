-- KyxLife PC Mode with Visual Effects, Keybinds & Prompt Activation

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local runService = game:GetService("RunService")

-- Variáveis principais
local autoFarmEnabled = false
local autoBankEnabled = false
local settingKeys = true
local keybinds = { AutoFarm = nil, AutoBank = nil, TpNPC = nil }

-- Criar função de notificação com efeito visual
local function showNotification(msg)
	local notif = Instance.new("TextLabel")
	notif.Text = msg
	notif.TextColor3 = Color3.new(1, 1, 1)
	notif.TextStrokeTransparency = 0
	notif.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
	notif.Size = UDim2.new(0, 250, 0, 40)
	notif.Position = UDim2.new(0.5, -125, 0.9, 0)
	notif.AnchorPoint = Vector2.new(0.5, 0)
	notif.Font = Enum.Font.GothamBold
	notif.TextSize = 18
	notif.BackgroundTransparency = 1
	notif.BorderSizePixel = 0
	notif.Parent = game:GetService("CoreGui")

	TweenService:Create(notif, TweenInfo.new(0.4), {BackgroundTransparency = 0.2}):Play()
	TweenService:Create(notif, TweenInfo.new(0.4), {TextTransparency = 0}):Play()

	task.delay(2.5, function()
		TweenService:Create(notif, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
		TweenService:Create(notif, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
		wait(0.6)
		notif:Destroy()
	end)
end

